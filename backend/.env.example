PORT=3000

# ========================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================================
# Selecciona el motor: 'sqlite' o 'mysql'
DB_DIALECT=sqlite

# Parámetros para SQLite:
DB_FILE=./database/inventario.sqlite

# Parámetros para MySQL (ej. XAMPP o MySQL Server):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventario_constructora

# ========================================================
# REGLAS DE NEGOCIO
# ========================================================
DUPLICATE_TIME_WINDOW_HOURS=72
DUPLICATE_QTY_TOLERANCE_PERCENT=5
APPROVAL_THRESHOLD_AMOUNT=250000
